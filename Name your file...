from flask import Flask, request, jsonify
import joblib
import numpy as np

app = Flask(__name__)

model = joblib.load("model.pkl")

@app.route('/')
def home():
    return "PredictX Weather API Running"

@app.route('/predict')
def predict():
    temp = float(request.args.get('temp'))
    humidity = float(request.args.get('humidity'))
    pressure = float(request.args.get('pressure'))
    wind = float(request.args.get('wind'))

    features = np.array([[temp, humidity, pressure, wind, 0, 0, humidity]])

    prediction = model.predict(features)[0]

    return jsonify({
        "prediction": int(prediction),
        "message": "Rain 🌧️" if prediction == 1 else "No Rain ☀️"
    })

app.run()
